{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true
  },
  "files": ["public/base/types.ts"],
  "include": ["*.ts", "*.js", "server/**/*.ts", "desktop/*.ts", "desktop/*.js"],
  "exclude": ["node_modules", "desktop/node_modules", "desktop/dist", "public", "test"]
}
